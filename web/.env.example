# Filled in after deploying the contracts to Monad testnet (see ../contracts).
# Leave empty to run the UI in demo mode with sample data.
NEXT_PUBLIC_KLEOS_ADDRESS=
NEXT_PUBLIC_USD_ADDRESS=
NEXT_PUBLIC_SOCIAL_ADDRESS=

# First Kleos block for event-history fallback reads. Monad testnet: 67114811.
# See DEPLOY.md for the deployed addresses and Vercel checklist.
NEXT_PUBLIC_KLEOS_DEPLOY_BLOCK=

# Leave unset on Vercel for Monad testnet. "local" targets `npx hardhat node`.
NEXT_PUBLIC_CHAIN=

# Server-only (no NEXT_PUBLIC_ prefix). The wallet that funds new passkey accounts with gas and
# test USD. It must be KleosUSD's sponsor. Never commit a real key.
SPONSOR_PRIVATE_KEY=
# Optional sponsorship budgets (fundings, not requests). Defaults: 5 per IP an hour, 10 a minute,
# 300 a day. Kept in memory per server instance.
# SPONSOR_PER_IP_PER_HOUR=5
# SPONSOR_PER_MINUTE=10
# SPONSOR_PER_DAY=300

# Server-only: a private Monad RPC (e.g. Chainstack) for server reads. Optional; the public RPC
# is used when empty. Never prefix with NEXT_PUBLIC_ (the URL usually embeds an API key).
MONAD_RPC_URL=

# Server-only: Envio HyperSync for event reads (feed, calls, reputation history). The public
# Monad RPC serves eth_getLogs 100 blocks at a time. Token: https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=
# Optional overrides; normally leave unset. HyperSync above is preferred for history reads.
# HYPERSYNC_URL=https://10143.hypersync.xyz
# MONAD_LOGS_RPC=https://10143.rpc.hypersync.xyz/<ENVIO_API_TOKEN>

# Server-only: the Envio Cloud GraphQL endpoint of the indexer (indexer/DEPLOY.md). Each Envio
# deployment has its own URL, so this changes when the indexer is redeployed. Never prefix with
# NEXT_PUBLIC_: all indexer queries run on the server, cached, to stay under the free plan's
# 100 queries a minute. Leave empty to read from the chain (or sample data in demo mode).
INDEXER_URL=
