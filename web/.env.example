# Filled in after deploying the contracts to Monad testnet (see ../contracts).
# Leave empty to run the UI in demo mode with sample data.
NEXT_PUBLIC_KLEOS_ADDRESS=
NEXT_PUBLIC_USD_ADDRESS=


# Set to "local" to target `npx hardhat node` instead of Monad testnet.
NEXT_PUBLIC_CHAIN=

# Server-only (no NEXT_PUBLIC_ prefix). The wallet that funds new passkey accounts with gas and
# test USD. It must be KleosUSD's sponsor. Never commit a real key.
SPONSOR_PRIVATE_KEY=
