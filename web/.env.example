# Filled in after deploying the contracts to Monad testnet (see ../contracts).
# Leave empty to run the UI in demo mode with sample data.
NEXT_PUBLIC_KLEOS_ADDRESS=
NEXT_PUBLIC_USD_ADDRESS=
NEXT_PUBLIC_SOCIAL_ADDRESS=


# Set to "local" to target `npx hardhat node` instead of Monad testnet.
NEXT_PUBLIC_CHAIN=

# Server-only (no NEXT_PUBLIC_ prefix). The wallet that funds new passkey accounts with gas and
# test USD. It must be KleosUSD's sponsor. Never commit a real key.
SPONSOR_PRIVATE_KEY=

# Server-only: a private Monad RPC (e.g. Chainstack) for server reads. Optional; the public RPC
# is used when empty. Never prefix with NEXT_PUBLIC_ (the URL usually embeds an API key).
MONAD_RPC_URL=

# Server-only: Envio HyperSync for event reads (feed, calls, reputation history). The public
# Monad RPC serves eth_getLogs 100 blocks at a time. Token: https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=
